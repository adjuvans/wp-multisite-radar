# Déploiement FTP : « make deploy-test » et « make deploy-prod ».
# Copier ce fichier en .env (ignoré par git, exclu du paquet), puis le remplir.
#
# Une ligne CLE=valeur, sans espace autour du « = ». Les valeurs sont lues telles quelles :
# pas d'expansion de $, pas de commentaire en fin de ligne ; guillemets simples ou doubles facultatifs.
#
# PROTOCOL     ftp (TLS si le serveur le propose), ftps (TLS implicite) ou sftp ; ftp si vide.
# PORT         vide : port par défaut du protocole.
# PLUGINS_DIR  dossier des extensions sur le serveur, tel que le voit le compte FTP, sans le slug :
#              le plugin est installé dans PLUGINS_DIR/multisite-radar. Le dossier doit exister.
# VERIFY_CERT  no si le certificat TLS du serveur ne correspond pas à HOST ; yes si vide.

TEST_FTP_PROTOCOL=ftp
TEST_FTP_HOST=
TEST_FTP_PORT=
TEST_FTP_USER=
TEST_FTP_PASSWORD=
TEST_FTP_PLUGINS_DIR=/www/wp-content/plugins
TEST_FTP_VERIFY_CERT=yes

PROD_FTP_PROTOCOL=ftp
PROD_FTP_HOST=
PROD_FTP_PORT=
PROD_FTP_USER=
PROD_FTP_PASSWORD=
PROD_FTP_PLUGINS_DIR=/www/wp-content/plugins
PROD_FTP_VERIFY_CERT=yes
