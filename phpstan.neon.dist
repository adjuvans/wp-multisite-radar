parameters:
	level: 6
	paths:
		- multisite-radar.php
		- includes
		- uninstall.php
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	scanFiles:
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
		- vendor/php-stubs/wp-cli-stubs/wp-cli-tools-stubs.php
	ignoreErrors:
		-
			identifier: missingType.iterableValue
